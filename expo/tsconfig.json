{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "noEmit": true,
    "types": []
  },
  "include": [
    "*.ts"
  ]
}